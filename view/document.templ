package view

import (
	"github.com/mrmissx/stashbin/view/icons"
	"github.com/mrmissx/stashbin/view/layout"
	"strings"
)

templ Document(content string, slug string) {
	{{ lines := strings.Split(content, "\n") }}
	@layout.BaseLayout() {
		@layout.Header() {
			@icons.Tools(slug)
		}
		<main>
			<div class="flex bg-secondary overflow-auto h-[calc(100vh-6rem)]">
				<div class="select-none text-right pl-2 pr-4 py-2 text-[#a2acaf]">
					for i := 1; i <= len(lines); i++ {
						<div>{ i }</div>
					}
				</div>
				<pre class="flex-1 px-4 py-2">
					for _, line := range lines {
						<div class="whitespace-pre-wrap">{ line }</div>
					}
				</pre>
			</div>
		</main>
		@layout.Footer()
	}
}
